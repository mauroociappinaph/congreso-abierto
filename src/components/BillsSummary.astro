---
// Bills by type and the stage funnel, with the caveat about what the movements file records (L8).
import DataTable from './ui/DataTable.astro';
import Funnel from './ui/Funnel.astro';
import type { BillsProfile } from '../lib/legislator-profile.ts';
import { formatNumber, STAGE_LABELS } from '../lib/view.ts';

interface Props {
  bills: BillsProfile;
  // whose bills, for the captions, e.g. "de Yedlin, Pablo Raúl"
  of?: string;
}

const { bills, of = '' } = Astro.props;
const suffix = of ? ` ${of}` : '';
---

<div class="bills">
  <Funnel
    title={`Proyectos${suffix} que llegaron al menos a cada etapa`}
    titleHidden={false}
    stages={bills.funnel.map(f => ({ label: STAGE_LABELS[f.stage], value: f.alcanzado }))}
    highlightLast
    note="Llegaron al menos a esta etapa."
  />
  <DataTable caption={`Proyectos${suffix} por tipo`} dense>
    <thead><tr><th scope="col">Tipo</th><th scope="col" class="num">Proyectos</th></tr></thead>
    <tbody>
      {bills.porTipo.map(t => <tr><td>{t.tipo}</td><td class="num">{formatNumber(t.count)}</td></tr>)}
    </tbody>
    <tfoot><tr><th scope="row">Total</th><td class="num"><strong>{formatNumber(bills.total)}</strong></td></tr></tfoot>
  </DataTable>
</div>
<p class="note">
  <strong>Presentado</strong> = sin movimientos registrados que muestren avance; el archivo de movimientos no registra giros de
  rutina ni dictámenes, por eso «Con dictamen» casi no aparece. «Sancionado» no significa «es ley»: las resoluciones y
  declaraciones se aprueban en una sola Cámara, y una ley sancionada todavía debe promulgarse.
</p>

<style>
  .bills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-3) var(--space-6);
    align-items: start;
  }
</style>
