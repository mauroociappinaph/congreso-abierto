---
// Proyectos: bills of the deputies in office, how far they got, and who files the most.
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHead from '../../components/home/PageHead.astro';
import ProjectsPanel from '../../components/ProjectsPanel.astro';
import { loadBills, loadDeputies, loadEntities, loadSenators } from '../../lib/sources.ts';

const [deputies, { senators }] = await Promise.all([loadDeputies(), loadSenators()]);
const [entities, bills] = await Promise.all([loadEntities(), loadBills(deputies, senators)]);
---

<SiteLayout title="Proyectos - Gastos y trabajo legislativo">
  <div class="page-wrap topic-page">
    <PageHead
      title="Proyectos"
      eyebrow="Diputados · proyectos presentados"
      lede="Los proyectos que presentaron los diputados y diputadas en funciones como primer firmante, hasta qué etapa llegaron y quiénes presentan más."
    />
    <ProjectsPanel bills={bills} deputies={deputies} relations={entities.relations} />
  </div>
</SiteLayout>

<style>
  .topic-page {
    padding-top: var(--space-7);
  }
</style>
