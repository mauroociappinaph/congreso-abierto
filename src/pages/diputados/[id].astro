---
// One page per deputy in office (01, Pantalla 2): key facts, the relation strip (bloc, province, committees, bills,
// trips, votes) and one section per source, each with its source and period.
// Every loader is memoized, so the sources are fetched once for all the pages.
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import LegislatorLayout from '../../layouts/LegislatorLayout.astro';
import BillsSummary from '../../components/BillsSummary.astro';
import PayPanel from '../../components/PayPanel.astro';
import SourceLine from '../../components/SourceLine.astro';
import DataTable from '../../components/ui/DataTable.astro';
import DotPlot from '../../components/ui/DotPlot.astro';
import RelationStrip from '../../components/ui/RelationStrip.astro';
import Section from '../../components/ui/Section.astro';
import StatTile from '../../components/ui/StatTile.astro';
import { bandsDescription, surname, travelDotRows } from '../../components/home/travel-dots.ts';
import { buildDeputyProfiles } from '../../lib/legislator-profile.ts';
import { loadBills, loadCommittees, loadDeputies, loadEntities, loadMissions, loadPay, loadSenators, loadTravel } from '../../lib/sources.ts';
import { cargoLabel, DATASETS, formatDate, formatNumber, STAGE_LABELS, travelComparison, travelStatus } from '../../lib/view.ts';

export const getStaticPaths = (async () => {
  const [deputies, { senators }] = await Promise.all([loadDeputies(), loadSenators()]);
  const [travel, committees, bills, missions] = await Promise.all([
    loadTravel(deputies), loadCommittees(deputies), loadBills(deputies, senators), loadMissions(deputies),
  ]);
  const profiles = buildDeputyProfiles(deputies, { committees: committees.byDeputy, bills: bills.byLegislator, missions: missions.deputies });
  const travelById = new Map(travel.analysis.deputies.map(t => [t.deputyId, t]));
  return deputies.map(deputy => ({
    params: { id: deputy.id },
    props: { deputy, profile: profiles.get(deputy.id)!, travel: travelById.get(deputy.id) ?? null },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { deputy, profile, travel } = Astro.props as Props;
const deputies = await loadDeputies();
const { senators } = await loadSenators();
const [entities, pay, report, committeesData, billsData, missionsData] = await Promise.all([
  loadEntities(), loadPay(), loadTravel(deputies), loadCommittees(deputies), loadBills(deputies, senators), loadMissions(deputies),
]);
const rel = entities.relations.get(deputy.id)!;
const { bills, missions } = profile;
const committeeById = new Map(entities.committees.map(c => [c.id, c]));
const committees = rel.committees.map(c => ({ ...c, integrantes: committeeById.get(c.id)?.integrantes ?? null }));
const provincePage = rel.province ? entities.provinces.find(p => p.slug === rel.province!.slug) ?? null : null;
const nombreById = new Map(deputies.map(d => [d.id, d.nombre]));
const travelById = new Map(report.analysis.deputies.map(t => [t.deputyId, t]));
const committeesQuality = committeesData.quality;
const name = surname(deputy.nombre);

const plural = (count: number, one: string, many: string) => `${formatNumber(count)} ${count === 1 ? one : many}`;
const money = (value: { amount: number; currency: string } | null) => (value ? `${value.currency} ${formatNumber(value.amount)}` : '—');
const dateRange = (desde: string | null, hasta: string | null) =>
  desde && hasta && desde !== hasta ? `${formatDate(desde)} al ${formatDate(hasta)}` : formatDate(desde ?? hasta);

const status = travel ? travelStatus(travel) : null;
const STATUS_SHORT = {
  'en-linea': 'En línea con sus pares',
  'viaja-mas': 'Viaja bastante más que sus pares',
  'sin-tramos': 'Sin tramos registrados',
  'no-comparado': 'No comparado',
  'sin-distancia': 'No comparado',
} as const;
const travelTag = status ? STATUS_SHORT[status] : 'Sin tramos registrados';
const travelTone = status === 'viaja-mas' ? 'flag' : status === 'en-linea' ? 'ok' : 'default';

const plainMember = committees.every(c => c.cargo === 'integrante');
const committeesSummary =
  committees.length === 0 ? 'ninguna registrada' : plainMember ? `${committees.length}, ${committees.length === 1 ? 'como integrante' : 'todas como integrante'}` : String(committees.length);

const peers = (provincePage?.deputies ?? [])
  .map(m => ({ ...m, rel: entities.relations.get(m.id), rate: travelById.get(m.id)?.legsPerMonth ?? null }))
  .sort((a, b) => (b.rate ?? -1) - (a.rate ?? -1) || a.nombre.localeCompare(b.nombre, 'es'));
const provinceSenators = (provincePage?.senators ?? []).map(m => ({ ...m, rel: entities.relations.get(m.id) }));
const travelPeriod = report.windowLabel;
---

<LegislatorLayout
  title={`${deputy.nombre} - Diputados`}
  chamber="diputados"
  nombre={deputy.nombre}
  subtitle={`Por ${rel.province?.nombre ?? (deputy.lugar || 'N/A')} · Bloque ${rel.bloc.titulo}${deputy.mandato ? ` · Mandato ${deputy.mandato}` : ''}`}
  province={rel.province}
>
  <Fragment slot="facts">
    <StatTile label="Asumió" value={deputy.fechaInicio || 'N/A'} size="md" />
    <StatTile label="Tramos por mes" value={travel ? formatNumber(travel.legsPerMonth) : '—'} size="md" />
    <StatTile label="Misiones al exterior" value={formatNumber(missions?.count ?? 0)} size="md" />
    <StatTile label="Proyectos" value={formatNumber(bills?.total ?? 0)} size="md" />
    <StatTile label="Comisiones" value={formatNumber(committees.length)} size="md" />
  </Fragment>

  <RelationStrip
    label={`Relaciones de ${deputy.nombre}`}
    bloque={{ value: rel.bloc.titulo, detail: `${rel.bloc.seats} de ${rel.bloc.chamberSeats} diputados`, href: rel.bloc.url, cta: 'Ver el bloque' }}
    provincia={rel.province ? {
      value: rel.province.nombre,
      detail: `${plural(rel.province.deputies, 'diputado', 'diputados')} · ${plural(rel.province.senators, 'senador', 'senadores')}`,
      href: rel.province.url,
      cta: 'Ver la provincia',
    } : { value: deputy.lugar || 'Sin dato', detail: 'Distrito fuera de las 24 jurisdicciones' }}
    comisiones={{
      summary: committeesSummary,
      items: committees.map(c => ({ name: c.titulo, href: c.url, role: c.cargo === 'integrante' ? undefined : cargoLabel(c.cargo) })),
    }}
    proyectos={{ value: `${formatNumber(rel.counts.bills)} como primer firmante`, detail: plural(rel.counts.sancionados, 'sancionado', 'sancionados'), href: '#proyectos' }}
    viajes={{
      value: `${plural(rel.counts.legs ?? 0, 'tramo', 'tramos')} · ${plural(rel.counts.missions ?? 0, 'misión', 'misiones')}`,
      detail: status ? STATUS_SHORT[status] : 'Sin tramos registrados',
      href: '#viajes',
    }}
    votaciones={{ value: 'Sin datos', detail: 'Las votaciones de Diputados no están cargadas', href: '#votaciones' }}
    legend="Cada casilla lleva a otra página o sección. Los números de esta franja salen de las secciones de abajo, cada una con su fuente y su período."
  />

  <nav class="toc" aria-label="En esta ficha">
    <a href="#viajes">Viajes</a><a href="#misiones">Misiones</a><a href="#proyectos">Proyectos</a><a href="#comisiones">Comisiones</a>
    <a href="#votaciones">Votaciones</a><a href="#remuneracion">Remuneración</a><a href="#cargo">Datos del cargo</a>
    {provincePage && <a href="#pares">Sus pares de {provincePage.nombre}</a>}
  </nav>

  <Section title="Viajes nacionales" id="viajes" tag={travelTag} tagTone={travelTone} links={[DATASETS.viajes]} periodLabel={travelPeriod}>
    {
      travel ? (
        <>
          <dl class="stat-grid">
            <StatTile label="Tramos" value={formatNumber(travel.legs)} />
            <StatTile label="Meses en el cargo en el período" value={String(travel.months)} />
            <StatTile label="Tramos por mes" value={formatNumber(travel.legsPerMonth)} />
            <StatTile label="Su grupo por distancia" value={travel.band ?? 'Sin distancia estimada'} />
          </dl>
          <p><strong>Comparación con sus pares:</strong> {travelComparison(travel)}.</p>
          {travel.eligible && travel.band ? (
            <div class="dots">
              <DotPlot
                title={`Tramos por mes de ${deputy.nombre} frente a los diputados de cada grupo de distancia`}
                desc={`Cada punto es un diputado/a comparado y la raya vertical es la mediana de su grupo. ${bandsDescription(report.analysis)}. ${deputy.nombre}: ${formatNumber(travel.legsPerMonth)} en el grupo ${travel.band}; ${travelComparison(travel)}.`}
                rows={travelDotRows(report.analysis, nombreById, deputy.id)}
                unit="tramos por mes"
                max={Math.ceil(Math.max(1, ...report.analysis.deputies.filter(d => d.eligible).map(d => d.legsPerMonth)))}
                medianLabel="mediana del grupo"
              />
            </div>
          ) : null}
          <p class="note">
            Se compara con la mediana de su grupo y el desvío absoluto mediano; solo un z robusto mayor a 3,5 se describe como
            «viaja bastante más que sus pares». Comparar dentro de cada fila, nunca entre filas. Más tramos no implica
            irregularidad: depende de la distancia, la agenda y los traslados a la provincia.
          </p>
          {travel.topRoute && (
            <p class="note">Ruta más frecuente: {travel.topRoute.origen} ↔ {travel.topRoute.destino} ({plural(travel.topRoute.count, 'tramo', 'tramos')}).</p>
          )}
        </>
      ) : (
        <p>Sin tramos registrados a su nombre en el período.</p>
      )
    }
    <p class="xlink">
      <a href={rel.bloc.url}>Viajes del bloque</a>
      {rel.province && <a href={rel.province.url}>Viajes de {rel.province.nombre}</a>}
      <a href="/viajes/#metodo">Cómo se calcula</a>
    </p>
  </Section>

  <Section
    title="Misiones oficiales al exterior"
    id="misiones"
    tag={missions ? plural(missions.count, 'misión', 'misiones') : 'Sin misiones'}
    links={[DATASETS.misiones]}
    period={missionsData.period}
  >
    {
      missions ? (
        <>
          <DataTable caption={`Misiones oficiales de ${deputy.nombre}`} captionHidden dense>
            <thead>
              <tr>
                <th scope="col">Fechas</th><th scope="col">Lugar</th><th scope="col">Motivo</th><th scope="col">Institución que invita</th>
                <th scope="col" class="num">Viáticos otorgados</th><th scope="col" class="num">Viáticos consumidos</th>
              </tr>
            </thead>
            <tbody>
              {missions.missions.map(m => (
                <tr>
                  <td>{dateRange(m.fechaInicio, m.fechaFin)}</td>
                  <td>{m.lugar || '—'}</td>
                  <td>{m.motivo || '—'}</td>
                  <td>{m.institucion || '—'}</td>
                  <td class="num">{money(m.viaticosOtorgados)}</td>
                  <td class="num">{money(m.viaticosConsumidos)}</td>
                </tr>
              ))}
            </tbody>
          </DataTable>
          <p class="note">«—» indica que la Cámara no publicó el dato. Una misión oficial es una actividad institucional.</p>
        </>
      ) : (
        <p>Sin misiones oficiales registradas a su nombre en el período.</p>
      )
    }
    <p class="note quality-note">
      <strong>{formatNumber(missionsData.quality.rows.linkedPercent)} %</strong> de los registros de misiones del período quedaron
      asignados a un diputado/a; los casos dudosos no se asignan. <a href="/viajes/#misiones">Ver la calidad del emparejamiento</a>.
    </p>
  </Section>

  <Section
    title="Proyectos presentados"
    id="proyectos"
    tag={bills ? `${formatNumber(bills.total)} como primer firmante` : 'Sin proyectos'}
    links={[DATASETS.proyectos, DATASETS.movimientos]}
    period={billsData.period}
  >
    {
      bills ? (
        <>
          <BillsSummary bills={bills} of={`de ${name}`} />
          <h3 class="sub-title">Últimos proyectos</h3>
          <DataTable caption={`Últimos proyectos de ${deputy.nombre}`} captionHidden dense>
            <thead>
              <tr><th scope="col">Fecha</th><th scope="col">Expediente</th><th scope="col">Tipo</th><th scope="col">Título</th><th scope="col">Etapa registrada</th></tr>
            </thead>
            <tbody>
              {bills.recent.map(b => (
                <tr>
                  <td>{formatDate(b.fecha)}</td>
                  <td>{b.expediente || '—'}</td>
                  <td>{b.tipo}</td>
                  <td>{b.titulo}</td>
                  <td>{STAGE_LABELS[b.stage]}</td>
                </tr>
              ))}
            </tbody>
          </DataTable>
        </>
      ) : (
        <p>Sin proyectos registrados como primer firmante en el período.</p>
      )
    }
    <p class="note">
      La fuente indica un solo autor por proyecto (el primer firmante); no incluye a los cofirmantes. Asignación de autores:
      {formatNumber(billsData.quality.diputados.rows.linkedPercent)} %.
    </p>
    <p class="xlink"><a href={rel.bloc.url}>Proyectos del bloque</a><a href="/proyectos/">Todos los proyectos</a></p>
  </Section>

  <div class="grid2">
    <Section
      title="Comisiones"
      id="comisiones"
      tag={String(committees.length)}
      links={[DATASETS.comisiones]}
      periodLabel={`composición vigente al ${formatDate(committeesData.period.hasta)}`}
    >
      {
        committees.length > 0 ? (
          <DataTable caption={`Comisiones de ${deputy.nombre}`} captionHidden dense>
            <thead><tr><th scope="col">Comisión</th><th scope="col">Cargo</th><th scope="col" class="num">Integrantes</th></tr></thead>
            <tbody>
              {committees.map(c => (
                <tr>
                  <td><a href={c.url}>{c.titulo}</a></td>
                  <td>{cargoLabel(c.cargo)}</td>
                  <td class="num">{c.integrantes === null ? '—' : formatNumber(c.integrantes)}</td>
                </tr>
              ))}
            </tbody>
          </DataTable>
        ) : (
          <p>Sin comisiones registradas a su nombre.</p>
        )
      }
      <p class="note">
        Calidad del emparejamiento: {formatNumber(committeesQuality.rows.linkedPercent)} % de las filas de integrantes y autoridades
        quedaron asignadas a un diputado/a ({formatNumber(committeesQuality.rows.matchedCurrent + committeesQuality.rows.matchedFormer)}
        de {formatNumber(committeesQuality.rows.total)}); {plural(committeesQuality.names.doubtful, 'nombre dudoso', 'nombres dudosos')} y
        {plural(committeesQuality.names.unmatched, 'nombre sin emparejar', 'nombres sin emparejar')} no se asignan.
      </p>
    </Section>

    <Section title="Votaciones" id="votaciones">
      <p>
        Este sitio todavía no incluye las votaciones nominales de Diputados. En las fichas de senadores esta sección muestra la
        asistencia, la lealtad al bloque y la cohesión del bloque, con las actas oficiales del Senado.
      </p>
      <p class="xlink"><a href="/senado/#votaciones">Votaciones del Senado</a></p>
    </Section>
  </div>

  <div class="grid2">
    <PayPanel pay={pay} asOf={entities.topics.pay.provenance.hasta} deputies={deputies.length} title="Remuneración" />

    <Section title="Datos del cargo" id="cargo" links={[DATASETS.legisladores]} periodLabel={`composición ${entities.topics.numbers.diputados.provenance.label}`}>
      <dl class="facts">
        <div><dt>Distrito</dt><dd>{rel.province ? <a href={rel.province.url}>{rel.province.nombre}</a> : deputy.lugar || 'N/A'}</dd></div>
        <div><dt>Bloque</dt><dd><a href={rel.bloc.url}>{rel.bloc.titulo}</a></dd></div>
        <div><dt>Mandato</dt><dd>{deputy.mandato || 'N/A'}</dd></div>
        <div><dt>Fecha de jura</dt><dd>{deputy.fechaJura || 'N/A'}</dd></div>
        <div><dt>Fecha de inicio</dt><dd>{deputy.fechaInicio || 'N/A'}</dd></div>
      </dl>
    </Section>
  </div>

  {
    provincePage && (
      <Section title={`Sus pares de ${provincePage.nombre}`} id="pares" tag={plural(peers.length, 'diputado', 'diputados')}>
        <a slot="head" class="head-link" href={provincePage.url}>Página de {provincePage.nombre} →</a>
        <DataTable caption={`Diputados de ${provincePage.nombre} y sus tramos por mes`} captionHidden dense class="peers">
          <thead><tr><th scope="col">Diputado/a</th><th scope="col">Bloque</th><th scope="col" class="num">Tramos por mes</th></tr></thead>
          <tbody>
            {peers.map(p => (
              <tr class:list={{ current: p.id === deputy.id }}>
                <td>{p.id === deputy.id ? <strong>{p.nombre}</strong> : <a href={p.url}>{p.nombre}</a>}</td>
                <td>{p.rel ? <a href={p.rel.bloc.url}>{p.rel.bloc.titulo}</a> : '—'}</td>
                <td class="num">{p.rate === null ? '—' : formatNumber(p.rate)}</td>
              </tr>
            ))}
          </tbody>
        </DataTable>
        {provinceSenators.length > 0 && (
          <p class="note">
            Senadores de {provincePage.nombre}:{' '}
            {provinceSenators.map((s, i) => (
              <>
                {i > 0 && ', '}
                <a href={s.url}>{s.nombre}</a>
                {s.rel && ` (${s.rel.bloc.titulo})`}
                {i === provinceSenators.length - 1 && '.'}
              </>
            ))}
          </p>
        )}
        <SourceLine links={[DATASETS.legisladores, DATASETS.viajes]} periodLabel={`composición ${entities.topics.numbers.diputados.provenance.label}; tramos ${travelPeriod}`} />
        <SourceLine links={[DATASETS.senadores]} periodLabel={`listado ${entities.topics.numbers.senadores.provenance.label}`} />
      </Section>
    )
  }
</LegislatorLayout>

<style>
  /* the DotPlot's visually hidden table is as wide as its longest row; keep it from widening the page */
  .dots {
    position: relative;
    overflow: hidden;
  }

  .xlink {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
  }

  .quality-note strong {
    color: var(--quality);
  }

  .head-link {
    font-size: var(--text-sm);
  }
</style>
