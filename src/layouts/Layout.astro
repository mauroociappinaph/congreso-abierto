---
// Base document: head, design tokens and shared styles. SiteLayout adds the header, nav and footer.
import '../styles/tokens.css';
import '../styles/shared.css';
import { absoluteUrl, displayName, shareImagePath, SITE_NAME } from '../lib/seo.ts';

interface Props {
  // page name; the site name is appended unless the title already carries it
  title: string;
  description?: string;
  // keeps temporary pages (the style guide) out of search engines
  noindex?: boolean;
}

const {
  title,
  description = 'Congreso Abierto: gastos y trabajo legislativo de diputados y senadores de Argentina, con fuentes oficiales y período en cada dato.',
  noindex = false,
} = Astro.props;

const fullTitle = title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
// Open Graph and canonical URLs are absolute under `site` (astro.config.mjs).
const pageUrl = absoluteUrl(Astro.site, Astro.url.pathname);
// Legislator pages have their own card (src/pages/og/); every other page shares the site image.
const ownImage = shareImagePath(Astro.url.pathname);
const ogImage = absoluteUrl(Astro.site, ownImage ?? '/og.png');
const ogImageAlt = ownImage
  ? `Tarjeta de ${displayName(title.replace(/ - (Diputados|Senado)$/, ''))}: iniciales, cámara, distrito, bloque y un dato clave, con el sello de ${SITE_NAME}`
  : 'Logo de Congreso Abierto junto a una acuarela celeste del Palacio del Congreso de la Nación';
// Vercel Web Analytics: cookieless page views, only in builds made by Vercel (it sets VERCEL=1).
const analytics = process.env.VERCEL === '1';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={pageUrl} />}
    <title>{fullTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {analytics && <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>}
    {analytics && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body>
    <slot />
  </body>
</html>
