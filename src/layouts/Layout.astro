---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Diputados y senadores de Argentina y la remuneración que publica la Cámara de Diputados." />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    background: #f5f5f5;
    color: #333;
  }

  .note {
    font-size: 12px;
    color: #666;
    margin: 6px 0 0;
  }

  /* Shared by the panels and the legislator pages. */
  .box {
    border: 1px solid #d6e4fb;
    background: #f3f8ff;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .box p {
    margin: 0 0 8px;
  }

  .box ul {
    margin: 0 0 8px;
    padding-left: 20px;
  }

  .data-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 13px;
    margin-bottom: 20px;
  }

  .data-table th,
  .data-table td {
    border-bottom: 1px solid #eee;
    padding: 6px 8px;
    text-align: left;
    vertical-align: top;
  }

  .data-table th {
    background: #f7f7f7;
  }

  .data-table .num {
    text-align: right;
    white-space: nowrap;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .muted {
    color: #888;
    font-size: 12px;
  }

  .source {
    font-size: 12px;
    color: #666;
    margin: 0 0 12px;
  }

  .source a,
  .data-table a {
    color: #1a73e8;
  }
</style>
