---
// Stage funnel (02 "Proyectos"): how many reached at least each stage, with the share of the first stage.
// An ordered list, so the order of the stages is read out; the bars are decoration.
import { formatNumber, formatShare } from '../../lib/view.ts';
import { uid } from './ids.ts';

interface Stage {
  label: string;
  // count that reached at least this stage
  value: number;
}

interface Props {
  title: string;
  titleHidden?: boolean;
  stages: Stage[];
  // base of the shares; the first stage by default
  total?: number;
  // marks the last stage, e.g. "Sancionado"
  highlightLast?: boolean;
  // note under the funnel, e.g. "Llegaron al menos a esta etapa"
  note?: string;
}

const { title, titleHidden = true, stages, highlightLast = false, note } = Astro.props;
const total = Astro.props.total ?? stages[0]?.value ?? 0;
const id = uid('embudo');
const width = (value: number) => (total > 0 ? Math.max(0, Math.min(100, (value / total) * 100)) : 0);
---

<figure class="funnel">
  <figcaption id={id} class:list={['title', { 'visually-hidden': titleHidden }]}>{title}</figcaption>
  <ol aria-labelledby={id}>
    {
      stages.map((stage, i) => (
        <li class:list={{ hi: highlightLast && i === stages.length - 1 }}>
          <span class="label">{stage.label}</span>
          <span class="value">
            {formatNumber(stage.value)}
            {i > 0 && total > 0 && <span class="share"> · {formatShare(stage.value / total)}</span>}
          </span>
          <span class="track" aria-hidden="true">
            <span class="bar" style={{ width: `${width(stage.value)}%` }} />
          </span>
        </li>
      ))
    }
  </ol>
  {note && <p class="note">{note}</p>}
</figure>

<style>
  .funnel {
    margin: 0;
  }

  .title {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-bottom: var(--space-1);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px var(--space-2);
    padding: 3px 0 6px;
  }

  .value {
    font-weight: 700;
    white-space: nowrap;
  }

  .share {
    font-weight: 400;
    color: var(--muted);
  }

  .track {
    grid-column: 1 / -1;
    display: block;
    background: var(--line-soft);
  }

  .bar {
    display: block;
    height: 12px;
    min-width: 2px;
    background: var(--chart);
  }

  li.hi .bar {
    background: var(--quality);
  }

  li.hi .label {
    font-weight: 700;
  }
</style>
