---
import { formatArs } from '../lib/legislators.ts';
import type { PayData } from '../lib/sources.ts';

interface Props {
  pay: PayData;
}

const { summary, adicionales } = Astro.props.pay;
const stats = [
  { label: 'Dieta', value: summary.dieta },
  { label: 'Gastos de representación', value: summary.gastosRepresentacion },
  { label: 'Total bruto', value: summary.bruto },
  { label: 'Descuentos', value: summary.descuentos },
  { label: 'Neto estimado', value: summary.neto, net: true },
];
---

<div class="pay-panel">
  <h2>Remuneración mensual de cada diputado/a</h2>
  <p class="note">
    La Cámara publica montos únicos, iguales para todos los diputados; no publica gastos individuales por legislador.
  </p>
  <div class="pay-grid">
    {
      stats.map(stat => (
        <div class:list={['pay-stat', { net: stat.net }]}>
          <span>{stat.label}</span>
          <strong>{formatArs(stat.value)}</strong>
        </div>
      ))
    }
  </div>
  {
    adicionales.length > 0 && (
      <div class="pay-extra">
        Adicionales según corresponda a cada legislador:
        <ul>
          {adicionales.map(c => <li>{c.concepto}: {formatArs(c.importe)}</li>)}
        </ul>
      </div>
    )
  }
</div>

<style>
  .pay-panel {
    border: 1px solid #d6e4fb;
    background: #f3f8ff;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
  }

  h2 {
    margin: 0 0 4px;
    font-size: 18px;
  }

  .pay-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
    margin: 12px 0;
  }

  .pay-stat {
    background: white;
    border-radius: 6px;
    padding: 10px;
  }

  .pay-stat span {
    display: block;
    font-size: 12px;
    color: #666;
  }

  .pay-stat strong {
    font-size: 18px;
    color: #1a73e8;
  }

  .pay-stat.net strong {
    color: #2e7d32;
  }

  .pay-extra {
    font-size: 13px;
    color: #555;
  }

  .pay-extra ul {
    margin: 4px 0 0;
    padding-left: 20px;
  }
</style>
