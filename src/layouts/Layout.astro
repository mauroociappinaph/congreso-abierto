---
// Base document: head, design tokens and shared styles. SiteLayout adds the header, nav and footer.
import '../styles/tokens.css';
import '../styles/shared.css';

interface Props {
  title: string;
  description?: string;
  // keeps temporary pages (the style guide) out of search engines
  noindex?: boolean;
}

const {
  title,
  description = 'Gastos y trabajo legislativo de diputados y senadores de Argentina, con fuentes oficiales y período en cada dato.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
