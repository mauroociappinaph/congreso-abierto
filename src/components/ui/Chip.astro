---
// Pill that links to an entity page: "BLOQUE Unión por la Patria 92 dip.". Without href it renders as plain text.
export type EntityType = 'diputado' | 'senador' | 'bloque' | 'provincia' | 'comision' | 'proyecto' | 'viaje' | 'votacion';

interface Props {
  label: string;
  href?: string;
  // shown as a small prefix; omit for plain chips
  type?: EntityType;
  // trailing detail, e.g. "92 dip. · 21 sen."
  meta?: string;
  // the entity of the current page
  current?: boolean;
  size?: 'sm' | 'md';
}

const TYPE_LABELS: Record<EntityType, string> = {
  diputado: 'Diputado/a',
  senador: 'Senador/a',
  bloque: 'Bloque',
  provincia: 'Provincia',
  comision: 'Comisión',
  proyecto: 'Proyecto',
  viaje: 'Viajes',
  votacion: 'Votaciones',
};

const { label, href, type, meta, current = false, size = 'md' } = Astro.props;
const Tag = href && !current ? 'a' : 'span';
---

<Tag
  class:list={['chip', size, { current }]}
  href={Tag === 'a' ? href : undefined}
  aria-current={current ? 'page' : undefined}
>
  {type && <span class="type">{TYPE_LABELS[type]}</span>}
  <span class="label">{label}</span>
  {meta && <span class="meta">{meta}</span>}
</Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    max-width: 100%;
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  .chip.sm {
    padding: 1px 7px;
    font-size: var(--text-xs);
    background: var(--paper);
  }

  a.chip:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .chip.current {
    border-color: var(--ink);
    font-weight: 600;
  }

  .type {
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .meta {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  @media (prefers-reduced-motion: no-preference) {
    a.chip {
      transition: background-color 0.12s ease, border-color 0.12s ease;
    }
  }
</style>
