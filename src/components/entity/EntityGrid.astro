---
// Two columns at desktop (main 1.55fr, relations aside 1fr), one column on narrow screens.
interface Props {
  // names the aside landmark, e.g. "Relaciones del bloque"
  asideLabel: string;
}

const { asideLabel } = Astro.props;
---

<div class="entity-grid">
  <div class="main"><slot /></div>
  <aside aria-label={asideLabel}><slot name="aside" /></aside>
</div>

<style>
  .entity-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 0 var(--space-6);
    align-items: start;
  }

  .main,
  aside {
    min-width: 0;
  }

  @media (max-width: 960px) {
    .entity-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
