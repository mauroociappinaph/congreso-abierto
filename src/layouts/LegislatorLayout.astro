---
// Shared frame of the per-legislator pages: site frame, breadcrumb back to the chamber, person header.
import SiteLayout from './SiteLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

interface Props {
  title: string;
  // index tab to return to
  chamber: 'diputados' | 'senadores';
  nombre: string;
  subtitle: string;
  foto?: string;
}

const { title, chamber, nombre, subtitle, foto } = Astro.props;
const chamberLabel = chamber === 'diputados' ? 'Diputados' : 'Senadores';
const role = chamber === 'diputados' ? 'Diputado/a nacional' : 'Senador/a nacional';
// "Yedlin, Pablo Raúl" -> "PY"
const [surname = '', given = ''] = nombre.split(',').map(part => part.trim());
const initials = `${given.charAt(0)}${surname.charAt(0)}`.toUpperCase();
---

<SiteLayout title={title} current={chamber === 'diputados' ? 'diputados' : 'senado'}>
  <article class="page-wrap legislator" aria-labelledby="legislator-name">
    <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: chamberLabel, href: `/#${chamber}` }, { label: nombre }]} />
    <header class="who">
      {foto ? <img class="photo" src={foto} alt="" /> : <span class="photo initials" aria-hidden="true">{initials}</span>}
      <div>
        <p class="eyebrow">{role}</p>
        <h1 id="legislator-name">{nombre}</h1>
        <p class="sub">{subtitle}</p>
      </div>
    </header>
    <slot />
  </article>
  <p slot="footer"><a href={`/#${chamber}`}>Volver a {chamberLabel}</a></p>
</SiteLayout>

<style>
  .legislator {
    padding-top: var(--space-7);
  }

  .who {
    display: flex;
    gap: var(--space-5);
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .photo {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--badge);
  }

  .initials {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--surface);
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-size: clamp(26px, 4vw, var(--text-3xl));
    line-height: var(--leading-tight);
  }

  .sub {
    margin: var(--space-1) 0 0;
    color: var(--muted);
  }

  .legislator :global(section) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin-bottom: var(--space-5);
  }

  .legislator :global(h2) {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .legislator :global(.facts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0;
    margin: var(--space-3) 0;
    padding: 0;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
  }

  .legislator :global(.facts div) {
    padding: var(--space-2) var(--space-3);
    border-right: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .legislator :global(.facts dt) {
    font-size: var(--text-2xs);
    color: var(--muted);
  }

  .legislator :global(.facts dd) {
    margin: 2px 0 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
