---
// Horizontal bars with their values written out (01 "Por provincia", 02 topic cards). Plain HTML list, so labels
// can be links and screen readers read label and value in order; the bars themselves are decoration.
import { formatNumber } from '../../lib/view.ts';
import { uid } from './ids.ts';

interface Bar {
  label: string;
  value: number;
  // replaces the formatted value, e.g. "3 c/u", "834 · 9,4 %"
  valueLabel?: string;
  href?: string;
  // second line under the label, e.g. "86 diputados"
  detail?: string;
  // the bar of the current page or the finding
  highlight?: boolean;
  // secondary fill, e.g. grouped "other" rows
  muted?: boolean;
}

interface Props {
  // names the list for screen readers and is shown when not hidden
  title: string;
  titleHidden?: boolean;
  bars: Bar[];
  // full scale; the largest value by default
  max?: number;
  // label column width, e.g. "170px"
  labelWidth?: string;
}

const { title, titleHidden = true, bars, labelWidth = '170px' } = Astro.props;
const max = Astro.props.max ?? Math.max(...bars.map(b => b.value), 0);
const id = uid('barras');
// with a highlighted bar, the others step back to the secondary fill
const focus = bars.some(b => b.highlight);
const share = (value: number) => (max > 0 ? Math.max(0, Math.min(100, (value / max) * 100)) : 0);
---

<figure class="barchart">
  <figcaption id={id} class:list={['title', { 'visually-hidden': titleHidden }]}>{title}</figcaption>
  <ul class:list={{ focus }} aria-labelledby={id} style={{ '--label-w': labelWidth }}>
    {
      bars.map(bar => (
        <li class:list={{ hi: bar.highlight }}>
          <span class="label">
            {bar.href ? <a href={bar.href}>{bar.label}</a> : bar.label}
            {bar.detail && <small>{bar.detail}</small>}
          </span>
          <span class="track" aria-hidden="true">
            <span class:list={['bar', { muted: bar.muted, hi: bar.highlight }]} style={{ width: `${share(bar.value)}%` }} />
          </span>
          <span class="value">{bar.valueLabel ?? formatNumber(bar.value)}</span>
        </li>
      ))
    }
  </ul>
  <slot />
</figure>

<style>
  .barchart {
    margin: 0;
  }

  .title {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-bottom: var(--space-1);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  li {
    display: grid;
    grid-template-columns: var(--label-w) minmax(0, 1fr) auto;
    gap: var(--space-2);
    align-items: center;
    padding: 3px 0;
  }

  li.hi .label {
    font-weight: 700;
  }

  .label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .label a {
    color: var(--ink);
    text-decoration: none;
  }

  .label a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  small {
    display: block;
    font-size: var(--text-2xs);
    color: var(--muted);
    font-weight: 400;
  }

  .track {
    display: block;
  }

  .bar {
    display: block;
    height: 10px;
    min-width: 2px;
    background: var(--chart);
    border-radius: 0 2px 2px 0;
  }

  .focus .bar,
  .bar.muted {
    background: var(--chart-muted);
  }

  .focus .bar.hi {
    background: var(--chart);
  }

  .value {
    text-align: right;
    white-space: nowrap;
    font-weight: 600;
  }

  @media (max-width: 520px) {
    li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
