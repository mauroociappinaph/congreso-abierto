---
// Shared frame of the per-legislator pages (01, Pantalla 2): site frame, breadcrumb back to the chamber and the
// province, person header with its key facts (slot "facts", <StatTile>s), then the relation strip and sections.
// The page passes its own description and the schema.org Person (src/lib/seo.ts), rendered as JSON-LD.
import SiteLayout from './SiteLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { jsonLdScript } from '../lib/seo.ts';

interface Props {
  title: string;
  description: string;
  jsonLd: Record<string, unknown>;
  chamber: 'diputados' | 'senadores';
  nombre: string;
  subtitle: string;
  foto?: string;
  province?: { nombre: string; url: string } | null;
}

const { title, description, jsonLd, chamber, nombre, subtitle, foto, province } = Astro.props;
const chamberLabel = chamber === 'diputados' ? 'Diputados' : 'Senado';
const chamberHref = chamber === 'diputados' ? '/diputados/' : '/senado/';
const role = chamber === 'diputados' ? 'Diputado/a nacional' : 'Senador/a nacional';
const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: chamberLabel, href: chamberHref },
  ...(province ? [{ label: province.nombre, href: province.url }] : []),
  { label: nombre },
];
// "Yedlin, Pablo Raúl" -> "PY"
const [surname = '', given = ''] = nombre.split(',').map(part => part.trim());
const initials = `${given.charAt(0)}${surname.charAt(0)}`.toUpperCase();
---

<SiteLayout title={title} description={description} current={chamber === 'diputados' ? 'diputados' : 'senado'}>
  <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />
  <article class="page-wrap legislator" aria-labelledby="legislator-name">
    <Breadcrumb items={crumbs} />
    <header class="who">
      {foto ? <img class="photo" src={foto} alt="" /> : <span class="photo initials" aria-hidden="true">{initials}</span>}
      <div class="name">
        <p class="eyebrow">{role}</p>
        <h1 id="legislator-name">{nombre}</h1>
        <p class="sub">{subtitle}</p>
      </div>
      {Astro.slots.has('facts') && <dl class="keyfacts" aria-label="Datos clave"><slot name="facts" /></dl>}
    </header>
    <slot />
  </article>
  <p slot="footer"><a href={chamberHref}>Volver a {chamberLabel}</a></p>
</SiteLayout>

<style>
  .legislator {
    padding-top: var(--space-7);
  }

  .who {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-5);
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .name {
    flex: 1 1 260px;
    min-width: 0;
  }

  .keyfacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0;
  }

  .photo {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--badge);
  }

  .initials {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--surface);
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-size: clamp(26px, 4vw, var(--text-3xl));
    line-height: var(--leading-tight);
  }

  .sub {
    margin: var(--space-1) 0 0;
    color: var(--muted);
  }

  .legislator :global(.grid2) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 0 var(--space-5);
    align-items: start;
  }

  .legislator :global(.toc) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0 0 var(--space-5);
    font-size: var(--text-sm);
  }

  .legislator :global(h3.sub-title) {
    font-size: var(--text-lg);
    margin: var(--space-4) 0 var(--space-2);
  }

  .legislator :global(.facts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0;
    margin: var(--space-3) 0;
    padding: 0;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
  }

  .legislator :global(.facts div) {
    padding: var(--space-2) var(--space-3);
    border-right: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .legislator :global(.facts dt) {
    font-size: var(--text-2xs);
    color: var(--muted);
  }

  .legislator :global(.facts dd) {
    margin: 2px 0 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
