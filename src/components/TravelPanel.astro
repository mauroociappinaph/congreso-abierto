---
// Viajes nacionales: methodology, distance-band medians, every compared deputy against the band median, the
// per-deputy table (linking to the ficha, the province and the bloc) and the linkage quality (S5).
// The table is rendered at build time; the script only filters rows and shows a page of them at a time.
import Section from './ui/Section.astro';
import Pager from './ui/Pager.astro';
import BarChart from './ui/BarChart.astro';
import DataTable from './ui/DataTable.astro';
import DotPlot from './ui/DotPlot.astro';
import { bandsDescription, travelDotRows } from './home/travel-dots.ts';
import type { LegislatorRelations } from '../lib/entities.ts';
import { normalizeText, type Deputy } from '../lib/legislators.ts';
import { semesterLabel, type TravelReport } from '../lib/travel-report.ts';
import { MIN_BAND_PEERS, MIN_MONTHS, Z_THRESHOLD } from '../lib/viajes.ts';
import { DATASETS, formatNumber, travelComparison, travelStatus } from '../lib/view.ts';

interface Props {
  report: TravelReport;
  deputies: Deputy[];
  relations: Map<string, LegislatorRelations>;
}

const { report, deputies, relations } = Astro.props;
const { quality } = report;
const byId = new Map(deputies.map(d => [d.id, d]));
const nombreById = new Map(deputies.map(d => [d.id, d.nombre]));
const rows = report.analysis.deputies
  .flatMap(travel => {
    const deputy = byId.get(travel.deputyId);
    return deputy ? [{ travel, deputy, rel: relations.get(deputy.id) }] : [];
  })
  .sort((a, b) => b.travel.legsPerMonth - a.travel.legsPerMonth || a.deputy.nombre.localeCompare(b.deputy.nombre, 'es'));
const flagged = rows.filter(r => r.travel.flagged);
const compared = report.analysis.bands.reduce((t, b) => t + b.deputies, 0);
const pct = (value: number) => `${formatNumber(value)} %`;
const orDash = (value: number | null) => (value === null ? '—' : formatNumber(value));
const dotRows = travelDotRows(report.analysis, nombreById);
const maxRate = Math.max(1, ...rows.filter(r => r.travel.eligible).map(r => r.travel.legsPerMonth));
const period = report.windowLabel;
---

<Section title="Cómo se compara" id="metodo" eyebrow="Viajes nacionales" links={[DATASETS.viajes]} periodLabel={period}>
  <div class="method">
    <p>
      Contamos los tramos de viaje (cada vuelo o pasaje terrestre) que la Cámara publica para cada diputado/a entre el
      {semesterLabel(report.semesters[0])} y el {report.latestLabel}, y los dividimos por los meses en el cargo dentro de ese
      período: así, quien asumió hace poco no queda en desventaja.
    </p>
    <p>
      No es lo mismo viajar desde Jujuy que desde la Ciudad de Buenos Aires, ni desde Mar del Plata que desde el conurbano. Por
      eso cada diputado/a se compara con sus pares a distancia similar de Buenos Aires. Usamos una distancia estimada a partir de
      su ruta más frecuente o de la capital de su provincia: tomamos la terminal o el aeropuerto de su provincia que más aparece
      en sus tramos (al menos 3) y, si no hay, la capital provincial, y medimos la distancia en línea recta hasta el Obelisco.
      Con esa distancia armamos grupos (menos de 100 km, 100–400, 400–800, 800–1200 y 1200 km o más); un grupo con menos de
      {MIN_BAND_PEERS} diputados comparables se une al grupo vecino más cercano a Buenos Aires (el primero, al siguiente).
    </p>
    <p>
      Medimos cuánto se aparta cada uno de la mediana de su grupo usando el desvío absoluto mediano, una medida robusta: un par
      de casos extremos no mueven la comparación. Cuando ese puntaje (z robusto) supera {formatNumber(Z_THRESHOLD)} decimos que
      <strong>viaja bastante más que sus pares</strong>. Quienes tienen menos de {MIN_MONTHS} meses en el cargo dentro del período
      se muestran, pero no se comparan.
    </p>
  </div>
  <p class="note">Más tramos no implica irregularidad: depende de la distancia, la agenda y los traslados a la provincia.</p>
</Section>

<div class="grid2">
  <Section title="Mediana por distancia a Buenos Aires" id="grupos" tag={`${compared} diputados comparados`} links={[DATASETS.viajes]} periodLabel={period}>
    <BarChart
      title="Mediana de tramos por mes según la distancia estimada a Buenos Aires"
      labelWidth="120px"
      bars={report.analysis.bands.map(b => ({ label: b.band, value: b.medianLegsPerMonth, detail: `${b.deputies} diputados` }))}
    />
    <DataTable caption="Grupos por distancia estimada" captionHidden dense>
      <thead>
        <tr><th scope="col">Grupo</th><th scope="col" class="num">Comparados</th><th scope="col" class="num">Mediana tramos/mes</th><th scope="col" class="num">Mediana de distancia</th></tr>
      </thead>
      <tbody>
        {
          report.analysis.bands.map(b => (
            <tr>
              <td>{b.band}</td><td class="num">{b.deputies}</td><td class="num">{formatNumber(b.medianLegsPerMonth)}</td>
              <td class="num">{formatNumber(b.medianKm)} km</td>
            </tr>
          ))
        }
      </tbody>
    </DataTable>
  </Section>

  <Section
    title="Viajan bastante más que sus pares"
    id="destacados"
    tag={`${flagged.length} de ${compared}`}
    tagTone={flagged.length ? 'flag' : 'ok'}
    links={[DATASETS.viajes]}
    periodLabel={period}
  >
    {
      flagged.length > 0 ? (
        <ul class="flagged">
          {flagged.map(({ travel, deputy, rel }) => (
            <li>
              <a href={rel?.url ?? `/diputados/${deputy.id}/`}>{deputy.nombre}</a>
              {rel?.province && <> · <a href={rel.province.url}>{rel.province.nombre}</a></>}
              <span class="muted"> · {travel.band}: {formatNumber(travel.legsPerMonth)} tramos por mes (mediana {orDash(travel.bandMedian)})</span>
            </li>
          ))}
        </ul>
      ) : (
        <p>Nadie supera el umbral en el período.</p>
      )
    }
    <p class="note">Solo un z robusto mayor a {formatNumber(Z_THRESHOLD)} se describe así; es una comparación, no una evaluación de los viajes.</p>
  </Section>
</div>

<Section title="Cada diputado/a frente a su grupo" id="comparacion" links={[DATASETS.viajes]} periodLabel={period}>
  <div class="dots">
    <DotPlot
      title="Tramos por mes de los diputados comparados, por distancia estimada a Buenos Aires"
      desc={`Cada punto es un diputado/a y la raya vertical es la mediana de su grupo. ${bandsDescription(report.analysis)}. Destacados: ${flagged.map(r => `${r.deputy.nombre}, ${formatNumber(r.travel.legsPerMonth)}`).join('; ') || 'ninguno'}.`}
      rows={dotRows}
      unit="tramos por mes"
      max={Math.ceil(maxRate)}
      medianLabel="mediana del grupo"
    />
  </div>
  <p class="note">Comparar dentro de cada fila, nunca entre filas: la distancia explica buena parte de la diferencia.</p>
</Section>

<Section title="Tramos por diputado/a" id="tabla" tag={`${rows.length} diputados`} links={[DATASETS.viajes]} periodLabel={period}>
  <div class="travel" data-travel>
    <div class="controls">
      <label class="query">
        <span>Filtrar por nombre o provincia</span>
        <input type="search" autocomplete="off" spellcheck="false" placeholder="Ej.: Yedlin, Tucumán" data-query />
      </label>
      <label class="check"><input type="checkbox" data-only-flagged /> Solo quienes viajan bastante más que sus pares ({flagged.length})</label>
    </div>
    <p class="count" data-count>{rows.length} de {rows.length} diputados</p>
    <DataTable caption="Tramos de viajes nacionales por diputado/a" captionHidden dense>
      <thead>
        <tr>
          <th scope="col">Nombre</th><th scope="col">Provincia</th><th scope="col">Bloque</th><th scope="col" class="num">Distancia estimada</th>
          <th scope="col">Grupo</th><th scope="col" class="num">Tramos</th><th scope="col" class="num">Meses</th>
          <th scope="col" class="num">Tramos por mes</th><th scope="col" class="num">Mediana del grupo</th><th scope="col" class="num">z robusto</th>
          <th scope="col">Comparación</th><th scope="col">Ruta más frecuente</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ travel, deputy, rel }) => {
            const status = travelStatus(travel);
            return (
              <tr data-text={normalizeText(`${deputy.nombre} ${deputy.lugar}`)} data-flagged={String(travel.flagged)}>
                <td><a href={rel?.url ?? `/diputados/${deputy.id}/`}>{deputy.nombre}</a></td>
                <td>{rel?.province ? <a href={rel.province.url}>{rel.province.nombre}</a> : deputy.lugar}</td>
                <td>{rel ? <a href={rel.bloc.url}>{rel.bloc.titulo}</a> : deputy.bloque}</td>
                <td class="num">
                  {travel.homeKm === null ? '—' : `${formatNumber(travel.homeKm)} km`}
                  {travel.homeSource && <span class="muted"> ({travel.homeSource === 'ruta' ? 'ruta' : 'capital'})</span>}
                </td>
                <td>{travel.band ?? '—'}</td>
                <td class="num">{travel.legs}</td>
                <td class="num">{travel.months}</td>
                <td class="num">{formatNumber(travel.legsPerMonth)}</td>
                <td class="num">{orDash(travel.bandMedian)}</td>
                <td class="num">{orDash(travel.z)}</td>
                <td>
                  {status === 'viaja-mas' ? (
                    <span class="tag flag">Viaja bastante más que sus pares</span>
                  ) : status === 'en-linea' ? (
                    <span class="muted">En línea</span>
                  ) : (
                    <span class="muted">{travelComparison(travel)}</span>
                  )}
                </td>
                <td class="route">
                  {travel.topRoute ? `${travel.topRoute.origen} ↔ ${travel.topRoute.destino} (${travel.topRoute.count})` : '—'}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </DataTable>
    <Pager label="viajes por diputado/a" />
  </div>

  <div slot="after" class="box quality">
    <h3>Calidad del emparejamiento ({period})</h3>
    <p>
      Los viajes vienen con el nombre completo (por ejemplo «CHICONI RICARDO ABEL») y la composición de la Cámara con el nombre
      corto («Chiconi, Abel»). Los emparejamos comparando palabra por palabra con una medida de parecido (Jaro-Winkler) y un
      puntaje de confianza; los casos dudosos se informan y no se asignan.
    </p>
    <ul>
      <li>
        <strong>{pct(quality.latest.percent)}</strong> de los nombres emparejados automáticamente en el {report.latestLabel}
        ({quality.latest.matched} emparejados, {quality.latest.doubtful} dudosos, {quality.latest.unmatched} sin emparejar de
        {quality.latest.total}).
      </li>
      <li>
        <strong>{pct(quality.overall.percent)}</strong> en todo el período ({quality.overall.matched} emparejados,
        {quality.overall.doubtful} dudosos, {quality.overall.unmatched} sin emparejar de {quality.overall.total}).
      </li>
      <li>
        {pct(quality.legs.percent)} de los tramos quedaron asignados a un diputado/a ({formatNumber(quality.legs.linked)} de
        {formatNumber(quality.legs.total)}).
      </li>
    </ul>
    <p class="note">Los nombres sin emparejar son en su mayoría exdiputados: se compara contra la composición actual de la Cámara.</p>
    {
      quality.doubtful.length > 0 && (
        <details>
          <summary>Ver los casos dudosos ({quality.doubtful.length}, por nombre y provincia)</summary>
          <ul>
            {quality.doubtful.map(d => (
              <li>
                {d.nombre}
                {d.provincia && ` (${d.provincia})`}: posibles{' '}
                {d.candidates.map(c => `${c.nombre} (${c.lugar}, ${formatNumber(c.confidence)})`).join('; ')}
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
</Section>

<script>
  import { normalizeText } from '../lib/legislators.ts';
  import { mountPager } from './ui/pagination.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-travel]')) {
    const query = root.querySelector<HTMLInputElement>('[data-query]')!;
    const onlyFlagged = root.querySelector<HTMLInputElement>('[data-only-flagged]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('tbody tr[data-text]')];
    const pager = mountPager(root.querySelector('[data-pager]'), root.querySelector('[role="region"]'));

    const update = (reset = true) => {
      const q = normalizeText(query.value).trim();
      const matched = rows.filter(row => (!onlyFlagged.checked || row.dataset.flagged === 'true') && (!q || row.dataset.text!.includes(q)));
      if (pager) pager.show(rows, matched, { reset });
      else for (const row of rows) row.hidden = !matched.includes(row);
      count.textContent = `${matched.length} de ${rows.length} diputados`;
    };

    update(false);
    query.addEventListener('input', () => update());
    onlyFlagged.addEventListener('change', () => update());
  }
</script>

<style>
  .method p {
    margin: 0 0 var(--space-2);
    max-width: 860px;
  }

  /* the DotPlot's visually hidden table is as wide as its longest row; keep it from widening the page */
  .dots {
    position: relative;
    overflow: hidden;
  }

  .grid2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 0 var(--space-5);
    align-items: start;
  }

  .flagged {
    margin: 0 0 var(--space-2);
    padding-left: var(--space-5);
    font-size: var(--text-sm);
  }

  .flagged li {
    margin-bottom: var(--space-1);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: end;
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  .query span {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: 6px;
  }

  .query input {
    width: min(100%, 360px);
    padding: 7px 10px;
    border: 1px solid var(--placeholder);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--text-sm);
  }

  .query {
    flex: 1 1 260px;
    max-width: 100%;
  }

  .count {
    font-size: var(--text-xs);
    color: var(--muted);
    margin: 0 0 var(--space-2);
  }

  tr[hidden] {
    display: none;
  }

  .route {
    font-size: var(--text-xs);
    color: var(--muted);
    min-width: 180px;
  }

  .quality h3 {
    font-family: var(--sans);
    font-size: var(--text-sm);
    color: var(--quality);
    margin: 0 0 var(--space-2);
  }

  details ul {
    margin-top: 6px;
    font-size: var(--text-xs);
  }
</style>
