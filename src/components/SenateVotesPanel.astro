---
// Senate votes: bloc cohesion (each bloc linking to its Senate bloc page) and attendance from the official actas,
// with the linkage quality.
import QualityBox from './QualityBox.astro';
import Section from './ui/Section.astro';
import BarChart from './ui/BarChart.astro';
import DataTable from './ui/DataTable.astro';
import type { BlocPage } from '../lib/entities.ts';
import { normalizeText, type Senator } from '../lib/legislators.ts';
import type { SenateVotesData } from '../lib/sources.ts';
import { DATASETS, formatDate, formatNumber, formatShare } from '../lib/view.ts';

interface Props {
  votes: SenateVotesData;
  senators: Senator[];
  // Senate blocs, to link each cohesion row
  blocs: BlocPage[];
}

const EDGE = 5;
const { votes, senators, blocs: blocPages } = Astro.props;
const key = (value: string) => normalizeText(value).replace(/\s+/g, ' ').trim();
const pageByName = new Map(blocPages.filter(b => b.camara === 'senado').map(b => [key(b.nombre), b]));
const blocs = [...votes.summary.blocs]
  .filter(b => b.bloque)
  .sort((a, b) => b.senators - a.senators || a.bloque.localeCompare(b.bloque, 'es'))
  .map(b => ({ ...b, page: pageByName.get(key(b.bloque)) ?? null }));
const senatorUrl = (id: string) => `/senadores/${id}/`;
const attendance = senators
  .flatMap(senator => {
    const own = votes.summary.senators.get(senator.id);
    return own ? [{ senator, own, bloc: pageByName.get(key(senator.bloque)) ?? null }] : [];
  })
  .sort((a, b) => b.own.asistencia - a.own.asistencia || b.own.actas - a.own.actas || a.senator.nombre.localeCompare(b.senator.nombre, 'es'));
const groups = [
  { title: `Mayor asistencia (${EDGE})`, rows: attendance.slice(0, EDGE) },
  { title: `Menor asistencia (${EDGE})`, rows: attendance.slice(-EDGE).reverse() },
];
const repeated = votes.summary.inconsistencias.actasConFilasRepetidas;
const withRice = blocs.filter(b => b.riceMedio !== null);
---

<Section
  title="Votaciones del Senado"
  id="votaciones"
  tag={`${formatNumber(votes.actas)} actas nominales`}
  links={[DATASETS.actas]}
  period={votes.period}
>
  <p>
    {formatNumber(votes.actas)} actas de votación nominal entre el {formatDate(votes.period.desde)} y el
    {formatDate(votes.period.hasta)} (sin las votaciones canceladas).
  </p>
  {votes.stale && (
    <p class="note stale">
      El sitio del Senado no respondió al generar el sitio; se usan las actas guardadas al {formatDate(votes.cacheDate)}.
    </p>
  )}
  {repeated.length > 0 && (
    <p class="note">
      {repeated.length === 1 ? 'Un acta publicada' : `${repeated.length} actas publicadas`} por el Senado repite filas (acta
      {repeated.join(', ')}): contamos una sola vez a cada senador
      {votes.summary.inconsistencias.votosDescartados > 0 && ` y descartamos ${votes.summary.inconsistencias.votosDescartados} votos repetidos con valores distintos`}.
    </p>
  )}

  <div class="grid2">
    <div>
      <h3>Cohesión por bloque</h3>
      <BarChart
        title="Índice de Rice medio por bloque del Senado"
        max={1}
        labelWidth="190px"
        bars={withRice.map(b => ({
          label: b.page?.titulo ?? b.bloque,
          href: b.page?.url,
          value: b.riceMedio!,
          detail: `${b.senators} ${b.senators === 1 ? 'senador' : 'senadores'} · ${b.actas} actas`,
          muted: b.senators <= 2,
        }))}
      />
      <p class="note">
        Índice de Rice = |afirmativos − negativos| / (afirmativos + negativos) del bloque en cada acta, promediado sobre las
        actas en que el bloque votó: 1 es un bloque que vota todo junto, 0 uno dividido a la mitad. Senadores cuenta a quienes
        votaron por el bloque en el período; con uno o dos (barras claras) el índice dice poco.
        {blocs.length > withRice.length && ` ${blocs.length - withRice.length} bloques sin votos afirmativos ni negativos no tienen índice.`}
      </p>
    </div>
    <div>
      <h3>Asistencia de los senadores en funciones</h3>
      {
        groups.map(group => (
          <DataTable caption={group.title} dense>
            <thead>
              <tr><th scope="col">Nombre</th><th scope="col">Bloque</th><th scope="col" class="num">Actas</th><th scope="col" class="num">Ausente</th><th scope="col" class="num">Asistencia</th></tr>
            </thead>
            <tbody>
              {group.rows.map(({ senator, own, bloc }) => (
                <tr>
                  <td><a href={senatorUrl(senator.id)}>{senator.nombre}</a></td>
                  <td>{bloc ? <a href={bloc.url}>{bloc.titulo}</a> : senator.bloque}</td>
                  <td class="num">{formatNumber(own.actas)}</td>
                  <td class="num">{formatNumber(own.ausente)}</td>
                  <td class="num">{formatShare(own.asistencia)}</td>
                </tr>
              ))}
            </tbody>
          </DataTable>
        ))
      }
      <p class="note">
        Asistencia = actas en que no figura ausente, sobre las actas desde que asumió. El acta registra «ausente» sin indicar el
        motivo (licencia, misión oficial u otro). Son estadísticas descriptivas: no evalúan el desempeño.
      </p>
    </div>
  </div>

  <QualityBox
    slot="after"
    title="Calidad del emparejamiento de las actas"
    quality={votes.quality}
    period={votes.period}
    rowsLabel="votos registrados"
    against="senadores en funciones hoy y los que figuran en las actas del período"
  />
</Section>

<style>
  .grid2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: var(--space-3) var(--space-6);
  }

  h3 {
    font-size: var(--text-lg);
    margin: var(--space-2) 0;
  }

  .stale {
    color: var(--flag);
  }
</style>
