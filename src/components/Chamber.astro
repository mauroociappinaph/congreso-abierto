---
// One chamber's list: text search, bloc and province chips, and a table whose names link to each ficha.
// The rows are rendered at build time; the script below only hides and shows them.
import DataTable from './ui/DataTable.astro';
import { normalizeText } from '../lib/legislators.ts';

interface Ref {
  slug: string;
  label: string;
  url: string;
}

export interface ChamberRow {
  id: string;
  nombre: string;
  url: string;
  provincia: Ref | null;
  // the raw district when it is not one of the 24
  distrito: string;
  bloc: Ref;
  // one per extra column, already formatted
  cells: string[];
}

interface Props {
  id: string;
  caption: string;
  // plural, e.g. "diputados"
  noun: string;
  rows: ChamberRow[];
  columns: string[];
}

const { id, caption, noun, rows, columns } = Astro.props;

const countBy = (refs: Ref[]) => {
  const counts = new Map<string, Ref & { count: number }>();
  for (const ref of refs) {
    const entry = counts.get(ref.slug) ?? { ...ref, count: 0 };
    entry.count++;
    counts.set(ref.slug, entry);
  }
  return [...counts.values()].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, 'es'));
};
const blocs = countBy(rows.map(r => r.bloc));
const provinces = countBy(rows.flatMap(r => (r.provincia ? [r.provincia] : []))).sort((a, b) => a.label.localeCompare(b.label, 'es'));
---

<div class="chamber" data-chamber={id} data-noun={noun}>
  <div class="filters">
    <label class="query">
      <span>Filtrar por nombre o provincia</span>
      <input type="search" autocomplete="off" spellcheck="false" placeholder="Ej.: Yedlin, Tucumán" data-query />
    </label>
    <fieldset>
      <legend>Bloque</legend>
      <div class="chips" data-filter="bloc">
        <button type="button" aria-pressed="true" data-value="">Todos <span>{rows.length}</span></button>
        {blocs.map(b => <button type="button" aria-pressed="false" data-value={b.slug}>{b.label} <span>{b.count}</span></button>)}
      </div>
    </fieldset>
    <fieldset>
      <legend>Provincia</legend>
      <div class="chips" data-filter="provincia">
        <button type="button" aria-pressed="true" data-value="">Todas</button>
        {provinces.map(p => <button type="button" aria-pressed="false" data-value={p.slug}>{p.label} <span>{p.count}</span></button>)}
      </div>
    </fieldset>
  </div>
  <p class="count" aria-live="polite" data-count>{rows.length} de {rows.length} {noun}</p>
  <DataTable caption={caption} captionHidden dense>
    {
      // as an expression: a mapped <th> in a literal <thead> makes the compiler close the slot early (Astro 6.4)
      (
        <thead>
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">Provincia</th>
            <th scope="col">Bloque</th>
            {columns.map(c => <th scope="col" class="num">{c}</th>)}
          </tr>
        </thead>
      )
    }
    <tbody>
      {
        rows.map(row => (
          <tr
            data-row
            data-text={normalizeText(`${row.nombre} ${row.provincia?.label ?? row.distrito}`)}
            data-bloc={row.bloc.slug}
            data-provincia={row.provincia?.slug ?? ''}
          >
            <th scope="row"><a href={row.url}>{row.nombre}</a></th>
            <td>{row.provincia ? <a href={row.provincia.url}>{row.provincia.label}</a> : row.distrito || '—'}</td>
            <td><a href={row.bloc.url}>{row.bloc.label}</a></td>
            {row.cells.map(cell => <td class="num">{cell}</td>)}
          </tr>
        ))
      }
    </tbody>
  </DataTable>
  <p class="empty" hidden data-empty>No hay {noun} que coincidan con el filtro.</p>
</div>

<script>
  import { normalizeText } from '../lib/legislators.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-chamber]')) {
    const query = root.querySelector<HTMLInputElement>('[data-query]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('tr[data-row]')];
    const selected: Record<string, string> = { bloc: '', provincia: '' };

    const update = () => {
      const q = normalizeText(query.value).trim();
      let visible = 0;
      for (const row of rows) {
        row.hidden =
          (!!selected.bloc && row.dataset.bloc !== selected.bloc) ||
          (!!selected.provincia && row.dataset.provincia !== selected.provincia) ||
          (!!q && !row.dataset.text!.includes(q));
        if (!row.hidden) visible++;
      }
      empty.hidden = visible > 0;
      count.textContent = `${visible} de ${rows.length} ${root.dataset.noun}`;
    };

    query.addEventListener('input', update);
    for (const group of root.querySelectorAll<HTMLElement>('[data-filter]')) {
      group.addEventListener('click', event => {
        const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
        if (!chip) return;
        selected[group.dataset.filter!] = chip.dataset.value!;
        group.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', String(b === chip)));
        update();
      });
    }
  }
</script>

<style>
  .filters {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .query span,
  legend {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: 6px;
    padding: 0;
  }

  .query input {
    width: min(100%, 420px);
    padding: 7px 10px;
    border: 1px solid var(--placeholder);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--text-sm);
    color: var(--ink);
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chips button {
    max-width: 100%;
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
    text-align: left;
  }

  .chips button span {
    color: var(--muted);
  }

  .chips button:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .chips button[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--surface);
    font-weight: 600;
  }

  .chips button[aria-pressed='true'] span {
    color: var(--surface);
  }

  .count {
    font-size: var(--text-xs);
    color: var(--muted);
    margin: 0 0 var(--space-2);
  }

  tr[hidden] {
    display: none;
  }

  th[scope='row'] {
    font-size: var(--text-sm);
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    border-bottom-color: var(--line-soft);
  }

  .empty {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
