---
// Remuneración: the single monthly amounts the Chamber publishes for every deputy, and the extras that depend on each one.
import Section from './ui/Section.astro';
import StatTile from './ui/StatTile.astro';
import { formatArs } from '../lib/legislators.ts';
import type { PayData } from '../lib/sources.ts';
import { DATASETS, formatDate } from '../lib/view.ts';

interface Props {
  pay: PayData;
  // YYYY-MM-DD of the amounts in force
  asOf: string | null;
  // number of deputies in office, for the tag
  deputies?: number;
  id?: string;
  level?: 2 | 3;
  title?: string;
}

const { pay, asOf, deputies, id = 'remuneracion', level = 2, title = 'Remuneración mensual de cada diputado/a' } = Astro.props;
const { summary, adicionales } = pay;
const stats = [
  { label: 'Dieta', value: summary.dieta },
  { label: 'Gastos de representación', value: summary.gastosRepresentacion },
  { label: 'Total bruto', value: summary.bruto },
  { label: 'Descuentos', value: summary.descuentos },
  { label: 'Neto estimado', value: summary.neto, tone: 'ok' as const },
];
---

<Section
  title={title}
  id={id}
  level={level}
  tag={deputies ? `Igual para los ${deputies}` : 'Igual para todos'}
  links={[DATASETS.dietas]}
  periodLabel={`montos vigentes al ${formatDate(asOf)}`}
>
  <dl class="stat-grid">
    {stats.map(stat => <StatTile label={stat.label} value={formatArs(stat.value)} size="md" tone={stat.tone} />)}
  </dl>
  <p class="note">
    La Cámara publica montos únicos, iguales para todos los diputados; no son gastos individuales. El Senado no publica dietas
    en sus datos abiertos.
  </p>
  {
    adicionales.length > 0 && (
      <details>
        <summary>Adicionales según corresponda a cada diputado/a ({adicionales.length})</summary>
        <ul>
          {adicionales.map(c => <li>{c.concepto}: {formatArs(c.importe)}</li>)}
        </ul>
      </details>
    )
  }
</Section>

<style>
  details {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  summary {
    color: var(--accent);
    cursor: pointer;
  }

  ul {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-5);
  }
</style>
